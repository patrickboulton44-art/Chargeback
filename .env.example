# Shopify app (from Partners Dashboard → your app → Settings)
SHOPIFY_API_KEY=your_client_id
SHOPIFY_API_SECRET=your_client_secret
# Optional override; defaults to https://chargeback-chi.vercel.app
# SHOPIFY_APP_URL=https://your-domain.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
# Optional; defaults to claude-sonnet-4-6
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# Token encryption at rest. Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes. Rotating invalidates all stored tokens
# (merchants would need to re-install).
ENCRYPTION_KEY=base64_of_32_random_bytes
